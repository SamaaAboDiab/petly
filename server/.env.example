PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/petly
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=7d
# Frontend origin(s) allowed by CORS and used in password-reset links.
CLIENT_URL=http://localhost:5173
# Optional: without a key, reset emails are printed to the console.
RESEND_API_KEY=
EMAIL_FROM=Petly <onboarding@resend.dev>
